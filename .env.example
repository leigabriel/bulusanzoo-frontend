# Copy to .env (never commit real values).
# API origin including /api. Leave unset in local dev to use <current host>:VITE_BACKEND_PORT.
# VITE_API_URL=https://service.bulusanzoo.com/api
# Backend origin used for OAuth redirects and uploaded files.
# VITE_BACKEND_URL=https://service.bulusanzoo.com
# VITE_BACKEND_PORT=5000
# VITE_APP_MODE=development
# Optional overrides for the mini-game links shown in the header.
# VITE_MINIZOO_GAME_URL=
# VITE_MINIZOO_ADVENTURE_GAME_URL=
# Google Maps key for the 3D wildlife map (read at build time, not prefixed with VITE_).
# GOOGLE_MAPS_API_KEY=
